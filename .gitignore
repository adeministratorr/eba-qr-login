# Byte-compiled / optimized / PVM cache
__pycache__/
*.py[cod]
*$py.class

# Operating System Files
.DS_Store
Thumbs.db

# Screen captures, live test QR codes, and images
*.png
*.jpg
*.jpeg
*.gif
*.webp

